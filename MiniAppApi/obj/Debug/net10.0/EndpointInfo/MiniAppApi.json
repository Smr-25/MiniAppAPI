{
  "openapi": "3.1.1",
  "info": {
    "title": "MiniAppApi | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:5000"
    }
  ],
  "paths": {
    "/api/Event": {
      "get": {
        "tags": [
          "Event"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Event"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EventCreateDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EventCreateDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EventCreateDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Organizer": {
      "get": {
        "tags": [
          "Organizer"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EventCreateDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "location": {
            "type": "string"
          },
          "organizerName": {
            "type": "string"
          },
          "bannerImageUrl": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Event"
    },
    {
      "name": "Organizer"
    }
  ]
}